    {
      "id": "2a888277-aadc-4100-aa06-99901d291a9d",
      "name": "Evaluar y preparar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "parameters": {
        "jsCode": "// El LLM propone, este nodo decide: solo se reserva un horario que B1 confirme libre en este momento.\nconst i = $('Entrada').first().json;\nconst b1 = $('Revalidar disponibilidad').first().json;\nconst cfg = b1.cfg || {};\nconst tz = cfg.zona_horaria || 'America/Montevideo';\nconst umbral = parseInt(cfg.umbral_grupo || '10');\nconst dur = parseInt(cfg.duracion_min || '60');\n// Normaliza la hora: '10', '10:00', '10hs' o '9:00' quedan como HH:MM.\nconst mh = String(i.hora || '').trim().match(/^(\\d{1,2})(?::?(\\d{2}))?/);\nconst hh = mh ? String(mh[1]).padStart(2, '0') + ':' + (mh[2] || '00') : '';\nconst personas = Number(i.personas);\nconst motivos = ['recorrido', 'centro_educativo', 'institucional', 'taller', 'otro'];\nconst faltan = [];\nif (!String(i.nombre || '').trim()) faltan.push('nombre');\nif (!String(i.contacto || '').trim()) faltan.push('contacto');\nif (!motivos.includes(String(i.motivo))) faltan.push('motivo (recorrido, centro_educativo, institucional, taller, otro)');\nif (faltan.length) return [{ json: { estado: 'datos_incompletos', faltan: faltan.join(', ') } }];\nif (!(b1.slots_libres || []).includes(hh)) {\n  return [{ json: { estado: 'no_disponible', fecha: i.fecha, hora: hh, motivo: b1.motivo || 'horario_ocupado_o_fuera_de_franja', slots_libres: (b1.slots_libres || []).join(', ') } }];\n}\nconst ahora = DateTime.now().setZone(tz);\nconst ini = DateTime.fromISO(i.fecha + 'T' + hh, { zone: tz });\nreturn [{ json: {\n  id: 'VIS-' + ahora.toFormat('yyyyMMddHHmmss') + '-' + Math.random().toString(36).slice(2, 6),\n  creado_en: ahora.toFormat('yyyy-MM-dd HH:mm:ss'), chat_id: String(i.chat_id), nombre: i.nombre, contacto: i.contacto,\n  motivo: i.motivo, motivo_otro: i.motivo_otro || '', fecha: i.fecha, hora: hh, personas: personas,\n  estado: personas > umbral ? 'pendiente_aprobacion' : 'confirmada', nota_staff: '', event_id: '',\n  csat_enviado: 'FALSE', csat_score: '', csat_comentario: '',\n  inicio: ini.toISO(), fin: ini.plus({ minutes: dur }).toISO(), umbral: umbral,\n  staff_chat_id: cfg.staff_chat_id || '', url_aprobacion: cfg.url_aprobacion || ''\n} }];"
      },
      "position": [
        520,
        320
      ],
      "notes": "Code: decide el estado (confirmada, pendiente por grupo >10, no disponible, datos incompletos) y arma la fila.",
      "notesInFlow": true
    },
