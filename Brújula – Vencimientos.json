    {
      "parameters": {
        "jsCode": "// Decide qué solicitudes pendientes vencieron. Solo lee; no escribe nada.\n// Vence si pasó el plazo de espera (espera_aprobacion_horas en config) desde que se creó,\n// o si la fecha y hora de la visita ya llegaron sin que nadie la aprobara.\nconst cfg = {};\nfor (const it of $('Leer config').all()) { if (it.json.clave) cfg[it.json.clave] = String(it.json.valor); }\nconst tz = cfg.zona_horaria || 'America/Montevideo';\nconst espera = parseInt(cfg.espera_aprobacion_horas || '24');\nconst ahora = DateTime.now().setZone(tz);\n\nconst filas = $('Leer pendientes').all().map(function (x) { return x.json; })\n  .filter(function (r) { return r && r.id && r.estado === 'pendiente_aprobacion'; });\n\nconst vencidas = [];\nfor (const r of filas) {\n  const creado = DateTime.fromFormat(String(r.creado_en || ''), 'yyyy-MM-dd HH:mm:ss', { zone: tz });\n  const visita = DateTime.fromISO(String(r.fecha) + 'T' + String(r.hora), { zone: tz });\n  let motivo = null;\n  if (visita.isValid && ahora >= visita) motivo = 'fecha_pasada';\n  else if (creado.isValid && ahora >= creado.plus({ hours: espera })) motivo = 'sin_respuesta';\n  // Si creado_en no se puede leer, no se rechaza sola: queda para que la resuelva el staff.\n  if (motivo) vencidas.push({ json: { id: r.id, motivo: motivo, espera_horas: espera } });\n}\nreturn vencidas;"
      },
